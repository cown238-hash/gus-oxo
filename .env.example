# Vercel Blob read/write token — required for uploads and the browse/admin pages.
BLOB_READ_WRITE_TOKEN=

# Password for the /admin backend (optional; without it /admin shows setup help).
ADMIN_PASSWORD=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX (optional).
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher id, e.g. ca-pub-XXXXXXXXXXXXXXXX (optional).
NEXT_PUBLIC_ADSENSE_ID=
